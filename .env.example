# Copy to .env and adjust as needed. .env is gitignored.

# --- HTTP server --------------------------------------------------------
PORT=8080
LOG_LEVEL=info        # debug | info | warn | error

# --- Database (consumed by the app) -------------------------------------
# Inside docker-compose the app reaches Postgres via the service name.
# When running the binary on the host, override with:
#   DATABASE_URL=postgres://fls:fls@localhost:5432/fls?sslmode=disable
DATABASE_URL=postgres://fls:fls@postgres:5432/fls?sslmode=disable

# --- Postgres (used by docker-compose) ----------------------------------
POSTGRES_USER=fls
POSTGRES_PASSWORD=fls
POSTGRES_DB=fls
